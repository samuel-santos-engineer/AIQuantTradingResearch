<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\AIQuantTradingResearch.Domain\AIQuantTradingResearch.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AutoSignTestBinaries Condition="'$(AutoSignTestBinaries)' == ''">false</AutoSignTestBinaries>
  </PropertyGroup>
  <Target 
    Name="AutoSignTestBinaries" 
    AfterTargets="Build"
    Condition="
      '$(AutoSignTestBinaries)' == 'true'
      and '$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <!-- Explicit path to your installed Windows SDK SignTool -->
      <SignToolExecutable>C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe</SignToolExecutable>
    </PropertyGroup>
    <Message Text="Local development Authenticode signing for Windows App Control compatibility: Automatically signing $(TargetPath)..." Importance="high" />
    <!-- Using exact double quotes around the executable path to handle Windows folder spaces -->
    <Exec Command="&quot;$(SignToolExecutable)&quot; sign /n &quot;AIQuantTradingDev&quot; /fd SHA256 /t http://timestamp.digicert.com &quot;$(TargetPath)&quot;" 
          ContinueOnError="WarnAndContinue" />
  </Target>
  <Import
    Project="$(MSBuildProjectDirectory)\..\..\Directory.Build.local.props"
    Condition="Exists('$(MSBuildProjectDirectory)\..\..\Directory.Build.local.props')" />
</Project>
